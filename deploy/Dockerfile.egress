FROM alpine:3.20

# El paquete crea el usuario `squid` (uid 31).
RUN apk add --no-cache squid && \
    mkdir -p /etc/squid/taap /var/log/squid /var/spool/squid /run/squid && \
    chown -R squid:squid /etc/squid /var/log/squid /var/spool/squid /run/squid

COPY deploy/squid/squid.conf /etc/squid/squid.conf
COPY deploy/squid/entrypoint.sh /usr/local/bin/egress-entrypoint
RUN chmod +x /usr/local/bin/egress-entrypoint

EXPOSE 3128
ENTRYPOINT ["/usr/local/bin/egress-entrypoint"]
