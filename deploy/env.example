# Copiar a deploy/.env (no commitear) y ajustar.
APP_KEY=
TAAP_VERSION=local
TAAP_PORT=8000
TAAP_WS_PORT=8080

DB_NAME=taap
DB_USER=taap
DB_PASSWORD=cambiar-esta-clave
APP_URL=http://127.0.0.1:8000

REVERB_APP_ID=taap-local
REVERB_APP_KEY=taap-local
REVERB_APP_SECRET=taap-local

# ---- FQDN y endpoint publico del websocket (Traefik) ----
# FQDN de los routers de Traefik (deploy/compose.traefik.yaml).
FQDN_TAAP=taap.test
FQDN_WS=ws.taap.test
# Endpoint publico que reciben los clientes (web + iOS) para abrir el WSS:
# la cara externa del Reverb interno (config/taap.php 'public'). Por defecto
# va por Traefik (TLS :443); el navegador bloquearia ws:// desde una pagina https.
TAAP_PUBLIC_HOST=ws.taap.test
TAAP_PUBLIC_SCHEME=https
TAAP_REVERB_PUBLIC_PORT=443
# Produccion en otro servidor:
#   FQDN_TAAP=taap.itlent.eus  FQDN_WS=ws.taap.itlent.eus
#   TAAP_PUBLIC_HOST=ws.taap.itlent.eus   (esquema/puerto se mantienen)
#   y regenera el certificado: make certs DOMAINS="taap.itlent.eus ws.taap.itlent.eus"
# Sin Traefik (solo LAN): TAAP_PUBLIC_HOST=<IP del host>
#   TAAP_PUBLIC_SCHEME=http  TAAP_REVERB_PUBLIC_PORT=<TAAP_WS_PORT>

# Esquema de las URLs que genera la app web (assets de Vite, redirects,
# url()/asset()). Con Traefik la pagina es https pero APP_URL es la URL
# interna http: fijar true evita el contenido mixto (CSS/JS no cargarian).
# Tri-estado (change configurable-https-urls): true -> https; false -> http;
# comentada -> derivado del esquema de APP_URL.
TAAP_FORCE_HTTPS=true
# Sin Traefik (solo http): TAAP_FORCE_HTTPS=false

# Directorio del host para el fragmento ACL de squid (bind en el contenedor egress)
TAAP_SQUID_DIR=/var/lib/taap/squid

# Raiz fisica del FS compartido (shared-filesystem, design D9): se monta
# como /data/fs en orquestador y cola, y los binds por path de cada agente
# salen de aqui. CAMBIARLA requiere recreate de orquestador + cola + todos
# los agentes (bind inmutable) y re-arranque con `taap:agents:reprovision`.
TAAP_FS_ROOT=/var/lib/taap/fs

# Proxy squid: IP FJO en taap-internal (el hostname resuelve dos IPs y curl
# puede salir por la interfaz egress, cuyo IP no esta en el ACL).
TAAP_EGRESS_PROXY=http://10.163.3.2:3128

# Imágenes de los agentes (make images las construye como taap/agent-*:local)
TAAP_PI_IMAGE=taap/pi:local
TAAP_CLAUDE_IMAGE=taap/agent-claude:local
TAAP_CODEX_IMAGE=taap/agent-codex:local
TAAP_OPENCODE_IMAGE=taap/agent-opencode:local
