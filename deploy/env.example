# Copiar a deploy/.env (no commitear) y ajustar.
APP_KEY=
TAAP_VERSION=local
TAAP_PORT=8000
TAAP_WS_PORT=8080

DB_NAME=taap
DB_USER=taap
DB_PASSWORD=cambiar-esta-clave
APP_URL=http://127.0.0.1:8000

REVERB_APP_ID=taap-local
REVERB_APP_KEY=taap-local
REVERB_APP_SECRET=taap-local

# Directorio del host para el fragmento ACL de squid (bind en el contenedor egress)
TAAP_SQUID_DIR=/var/lib/taap/squid

# Proxy squid: IP FJO en taap-internal (el hostname resuelve dos IPs y curl
# puede salir por la interfaz egress, cuyo IP no esta en el ACL).
TAAP_EGRESS_PROXY=http://10.163.3.2:3128

# Imágenes de los agentes (make images las construye como taap/agent-*:local)
TAAP_PI_IMAGE=taap/pi:local
TAAP_CLAUDE_IMAGE=taap/agent-claude:local
TAAP_CODEX_IMAGE=taap/agent-codex:local
TAAP_OPENCODE_IMAGE=taap/agent-opencode:local
