# Copiar a deploy/.env (no commitear) y ajustar.
APP_KEY=
TAAP_VERSION=local
TAAP_PORT=8000
TAAP_WS_PORT=8080

DB_NAME=taap
DB_USER=taap
DB_PASSWORD=cambiar-esta-clave
APP_URL=http://127.0.0.1:8000

REVERB_APP_ID=taap-local
REVERB_APP_KEY=taap-local
REVERB_APP_SECRET=taap-local

# Directorio del host para el fragmento ACL de squid (bind en el contenedor egress)
TAAP_SQUID_DIR=/var/lib/taap/squid
